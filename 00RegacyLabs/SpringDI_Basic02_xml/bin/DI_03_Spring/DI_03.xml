<?xml version="1.0" encoding="UTF-8"?>
<beans  xmlns="http://www.springframework.org/schema/beans"
	    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	    xsi:schemaLocation="http://www.springframework.org/schema/beans 
	                        http://www.springframework.org/schema/beans/spring-beans.xsd">

<!--  
객체의 생성과 조립(주입) 담당 > 순수한 자바 (xml 과 동일한 역할)

Spring regacy 에서는 객체의 생성과 조립
1. xml 파일 ( bean 요소 사용)
2. @Configuration 설정을 가지고 자바의 함수를 통해서 객체 생성


MessageBean messageBean = new  MessageBean_en();
messageBean.sayHello("hong");

컨테이너 안에
new  MessageBean_en();
new  MessageBean_kr();
-->
	<bean id="messageBean" class="DI_03_Spring.MessageBean_en"></bean>
</beans>



